#!/usr/bin/env bash
# browser-harness CLI bound to the isolated Chrome started by scripts/start-browser.sh.
# Use this instead of the bare `browser-harness` command, which attaches to the user's everyday Chrome.
#   scripts/bh <<'PY'
#   print(page_info())
#   PY
export BU_NAME="pony"
export BU_CDP_URL="http://127.0.0.1:${BH_PORT:-9333}"
export BH_TAB_MARKER=0
exec browser-harness "$@"
